# Generated by Cargo
# Target directory
/target

# These are backup files generated by rustfmt
**/*.rs.bk

# Remove cargo-expand temporary build directory
cargo-expand-check-history

# IDE - VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IDE - JetBrains (IntelliJ, RustRover, etc.)
.idea/

# Environment files
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Optional: Cargo.lock
# For applications, you should commit Cargo.lock.
# For libraries, you might want to ignore it.
# Cargo.lock
